# Template for runtime/stack.env (production) -- copy and fill in. Never commit the real file.
# Secrets that must not sit next to it live in runtime/secrets.env: HERMES_API_KEY, TELEGRAM_BOT_TOKEN, AUTH_SECRET
# (AUTH_SECRET signs the app login codes: at least 32 random characters, e.g. `openssl rand -hex 32`).
# Web push also needs VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY (`npx web-push generate-vapid-keys`) and VAPID_SUBJECT
# (an https address of the site, not a personal email: it is sent to the push services).
HOST=0.0.0.0
PORT=3000

POSTGRES_DB=aksis_ai
POSTGRES_USER=aksis_ai
POSTGRES_PASSWORD=replace-with-a-long-random-value
# The compose file gives the database the network alias aksis-ai-postgres.
DATABASE_URL=postgresql://aksis_ai:replace-with-a-long-random-value@aksis-ai-postgres:5432/aksis_ai

# Telegram admin bot: owners, comma separated numeric ids.
TELEGRAM_ADMIN_IDS=

WHATSAPP_ENABLED=true
WHATSAPP_SESSION_DIR=/data/whatsapp
WHATSAPP_MAX_TENANTS=3
# Operator's own WhatsApp number that sends login codes and notices; pair it from the Telegram menu.
SYSTEM_WHATSAPP_PHONE=
WHATSAPP_PAIRING_TIMEOUT_MINUTES=10
# Legacy single-tenant session; leave unset when every tenant pairs through onboarding.
WHATSAPP_TENANT_ID=

ANALYSIS_INTERNAL_TOKEN=replace-with-a-long-random-value
# Written by scripts/sync-public-url.sh when the quick tunnel starts.
PUBLIC_BASE_URL=http://localhost:18880
COOKIE_SECURE=true
DAILY_SUMMARY_HOUR_WIB=7
PUSH_DIGEST_HOUR_WIB=7
AUTO_DELETE_EXPIRED=false

# Hermes gateway (the API key belongs in runtime/secrets.env).
HERMES_ENABLED=true
HERMES_API_ENDPOINT=http://192.168.254.1:8642
HERMES_MODEL=deepseek-v4-flash
HERMES_VISION_MODEL=
HERMES_POLL_INTERVAL_MS=1000
